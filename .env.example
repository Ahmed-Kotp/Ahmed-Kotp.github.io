# Leave empty to hide the contact form. A mailto button is always shown.
# Formspree example: https://formspree.io/f/xxxxxxxx
# Web3Forms example: https://api.web3forms.com/submit
NEXT_PUBLIC_FORM_ENDPOINT=

# Required only for Web3Forms. Ignored by Formspree.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Set to "true" to load Vercel Analytics. Leave empty on Cloudflare or GitHub Pages.
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=
